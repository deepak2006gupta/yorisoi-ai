# Yorisoi AI Environment Configuration
# Copy this file to .env.local to set your custom keys.

# 1. AI API Keys (Choose Groq or Gemini, or provide both)
# Get Groq key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. PostgreSQL Connection (Optional - the app automatically uses fallback memory DB if not configured)
DATABASE_URL=postgresql://postgres:31488@127.0.0.1:5434/postgres
